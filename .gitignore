# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.idea/
*.swp
*.swo
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Tool caches and machine-local state (.config/ holds Chromium crash dumps etc.)
.cache/
.local/
.config/
.conversation/
.pnpm-store/
/generated-artifacts/

# Local planning and verification documents
/docs/PRD.md
/docs/IMPROVEMENT_PLAN.md
/docs/GITHUB_MIGRATION_PLAN.md
/docs/verification/

# Test outputs (Playwright)
playwright-report/
test-results/
blob-report/
playwright/.cache/
.test-work/

# Environment files — never commit credentials
.env
.env.*
!.env.example

# attached_assets/ is intentionally committed (brand asset originals; see artifacts/starter-kits/BRAND_ASSETS.md).

# Editor settings
.vscode/
.mcp.json
.gitattributes

# Local AI assistant and agent tooling
.squad/
.squad-workstream
.copilot/
.github/agents/
.github/skills/
.github/copilot-instructions.md
.github/workflows/squad-*.yml
.github/workflows/sync-squad-labels.yml
