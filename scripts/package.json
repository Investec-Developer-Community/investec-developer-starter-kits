{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:learning-kits": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/learning-kits.test.ts",
    "test:kits": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/kits-mock-only.test.ts ../artifacts/starter-kits/src/maintenance/spend-explorer.test.ts",
    "test:guidance": "tsx --tsconfig ../artifacts/starter-kits/tsconfig.json --test ../artifacts/starter-kits/src/maintenance/official-api-note.test.ts",
    "test:bundles": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/starter-bundle.test.ts",
    "test:card-code": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/card-code.test.mjs",
    "test:swipe": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/swipe-percentage.test.ts",
    "test:credentials": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/credential-safety.test.mjs",
    "test:mock-copy": "node --test ../artifacts/starter-kits/src/maintenance/mock-first-copy.test.mjs",
    "test:library-query": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/library-query.test.ts",
    "test:maintenance": "tsx --tsconfig ../artifacts/starter-kits/tsconfig.json --import ./test-fetch-local-only.mjs --test '../artifacts/starter-kits/src/maintenance/**/*.test.ts' '../artifacts/starter-kits/src/maintenance/**/*.test.mjs'",
    "test:ci-adapter": "node --import ./test-fetch-local-only.mjs --test ./ci-review-api.test.mjs",
    "test:offline": "pnpm run check:kit-sources && pnpm run test:maintenance && pnpm run test:ci-adapter",
    "test:demos": "tsx --tsconfig ../artifacts/starter-kits/tsconfig.json --test ../artifacts/starter-kits/src/maintenance/demo-mapping.test.ts",
    "generate:kit-sources": "node ./generate-engine-sources.mjs",
    "check:kit-sources": "node ./generate-engine-sources.mjs --check",
    "test:mappings": "node --experimental-strip-types --test ../artifacts/starter-kits/src/maintenance/api-mappings.test.ts",
    "review:api": "tsx ../artifacts/starter-kits/src/maintenance/review-official-api.ts",
    "test:api-review": "tsx --test ../artifacts/starter-kits/src/maintenance/official-contract-review.test.ts",
    "review:sources": "tsx ../artifacts/starter-kits/src/maintenance/review-sources.ts",
    "test:sources": "tsx --test ../artifacts/starter-kits/src/maintenance/source-review.test.ts",
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
